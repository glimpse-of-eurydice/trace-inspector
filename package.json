{
  "name": "trace-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types src/demo.ts",
    "demo:fixture": "tsc && node dist/demo-fixture.js",
    "record": "tsc && node dist/cli/record.js",
    "view": "tsc && node dist/cli/view.js",
    "view:demo": "tsc && node dist/cli/view.js demo",
    "compare:demo": "tsc && node dist/cli/compare-demo.js",
    "eval:golden": "tsc && node dist/cli/evaluate-golden-set.js",
    "test": "tsc && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/demo.js",
    "prepare:memory-case": "tsc && node dist/cli/prepare-memory-case.js",
    "record:memory-case": "tsc && node dist/cli/record-memory-case.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
